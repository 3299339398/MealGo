# Docker Compose reads .env after you copy this example.
DB_PASSWORD=mealgo-local-change-me
DB_PORT=3307
REDIS_PORT=6380
WEB_PORT=8081
SERVER_PORT=8080
ADMIN_JWT_SECRET=replace-with-a-long-random-admin-secret
USER_JWT_SECRET=replace-with-a-different-long-random-user-secret
MEALGO_PACKAGING_FEE=2

# Optional service credentials for local Java startup (Compose demo does not enable them).
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MERCHANT_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_API_V3_KEY=
WECHAT_CERTIFICATE_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=
